# Discord application settings
DISCORD_TOKEN=YOUR_BOT_TOKEN                        # Bot token from Discord Developer Portal
CLIENT_ID=YOUR_APPLICATION_ID                       # Discord application/client ID
GUILD_ID=YOUR_SERVER_ID                             # Discord server/guild ID
STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY                # Steam Web API key

# General bot settings
CDA_AVATAR_URL=                                     # Bot avatar URL (optional)
SPECIAL_ACCESS_ROLE_IDS=ID_1,ID_2                   # Roles allowed to use restricted options ("raw", "/example") (optional)
KF2_RECONNECT_DELAY_SECONDS=30                      # Delay before reconnecting to KF2 (if servers offline)
KF2_CONNECT_TIMEOUT_SECONDS=5                       # How much time we wait for KF2 connection before we try to reconnect (if servers offline)
KF2_REQUEST_TIMEOUT_SECONDS=60                      # How much time we wait for KF2 response before giving up (if server not responding but considered online)
KF2_KICK_VOTE_DISCORD_CHANNEL_IDS=ID_1,ID_2         # Default kick-vote Discord channels, comma-separated (optional)
KF2_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=ID_1,ID_2   # Default pause/skip-vote Discord channels, comma-separated (optional)
KF2_MONTHLY_REWARD_DISCORD_CHANNEL_IDS=ID_1,ID_2    # Monthly VIP reward summary channels, comma-separated (optional)
KF2_VOTE_TIMEOUT_SECONDS=40                         # How much time we wait for last vote (basically vote time window in the game)
KF2_KICK_VOTE_PASS_PERCENT=66                       # Positive vote percent needed to pass kick votes
KF2_PAUSE_VOTE_PASS_PERCENT=66                      # Positive vote percent needed to pass pause votes
KF2_SKIP_VOTE_PASS_PERCENT=100                      # Positive vote percent needed to pass skip votes
DISCORD_WEBHOOK_RATE_LIMIT_RETRY_LIMIT=5            # How many times script will retry to post webhook messages after Discord rate limits some of them
DISCORD_WEBHOOK_RETRY_INTERVAL_SECONDS=30           # If still failed after X attempts (or Discord service unavailable) - retry after Y seconds
DISCORD_RETRY_QUEUE_MAX_AGE_MINUTES=60              # Drop webhook/bot message retry queues after X minutes without success; 0 disables it
STEAM_USER_CACHE_RETENTION_DAYS=30                  # Remove saved Steam user information after this many days

# Log settings
LOG_FILE_RETENTION_DAYS=7                           # Keep daily log files for this many days; 0 disables file logging and log folder creation
TOGGLE_KF2_RECEIVE_BODY_LOGS=OFF                    # ON/OFF - log full payload bodies received from KF2 servers
TOGGLE_VOTE_LOGS=OFF                                # ON/OFF - enable extra vote-related console logs

# Slash command cooldown settings
COMMAND_PUBLIC_TOKEN_LIMIT=5                        # Limit without "hidden" option (slash commands used by default)
COMMAND_PRIVATE_TOKEN_LIMIT=10                      # Limit with option "hidden" = true
COMMAND_TOKEN_RESET_SECONDS=600                     # Token reset window in seconds
COMMAND_TOKEN_RESET_ANCHOR=day                      # day or restart (should reset window count from 00:00 or from bot restart time)
COMMAND_COOLDOWN_ROLE_MODE=blacklist                # Should users with certain roles be excluded from cooldowns (blacklist) or the only ones affected (whitelist)
COMMAND_COOLDOWN_ROLE_IDS=ID_1,ID_2                 # Role IDs used by cooldown role mode

# KF2 server 1
KF2_SERVER_1_ENABLED=false                          # Enable this server connection
KF2_SERVER_1_NAME=Normal                            # Display name
KF2_SERVER_1_DIFFICULTY=normal                      # Difficulty key used by slash commands
KF2_SERVER_1_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_1_PORT=2424                              # KF2 relay port
KF2_SERVER_1_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated (optional)
KF2_SERVER_1_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channels overrides, comma-separated (optional)
KF2_SERVER_1_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channels overrides, comma-separated (optional)
KF2_SERVER_1_WEBHOOK_URL=                           # Webhook for KF2 to Discord (optional)
KF2_SERVER_1_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_1_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_1_COMMANDS_ENABLED=true                  # Allow slash commands for this server

# KF2 server 2
KF2_SERVER_2_ENABLED=false                          # Enable this server connection
KF2_SERVER_2_NAME=Hard                              # Display name
KF2_SERVER_2_DIFFICULTY=hard                        # Difficulty key used by slash commands
KF2_SERVER_2_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_2_PORT=2425                              # KF2 relay port
KF2_SERVER_2_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated (optional)
KF2_SERVER_2_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channel overrides, comma-separated (optional)
KF2_SERVER_2_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channel overrides, comma-separated (optional)
KF2_SERVER_2_WEBHOOK_URL=                           # Webhook for KF2 to Discord (optional)
KF2_SERVER_2_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_2_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_2_COMMANDS_ENABLED=true                  # Allow slash commands for this server

