# Discord application settings
DISCORD_TOKEN=YOUR_BOT_TOKEN                        # Bot token from Discord Developer Portal
CLIENT_ID=YOUR_APPLICATION_ID                       # Discord application/client ID
GUILD_ID=YOUR_SERVER_ID                             # Discord server/guild ID
STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY                # Steam Web API key

# General bot settings
CDA_AVATAR_URL=                                     # Optional avatar URL
KF2_RECONNECT_DELAY_SECONDS=30                      # Delay before reconnecting to KF2
KF2_CONNECT_TIMEOUT_SECONDS=5                       # KF2 socket connect timeout
KF2_REQUEST_TIMEOUT_SECONDS=60                      # KF2 command response timeout
KF2_KICK_VOTE_DISCORD_CHANNEL_IDS=ID_1,ID_2         # Default kick-vote Discord channels, comma-separated
KF2_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=ID_1,ID_2   # Default pause/skip-vote Discord channels, comma-separated
KF2_VOTE_TIMEOUT_SECONDS=30                         # Discord script vote timeout
KF2_CONSOLE_LOGS_ENABLED=false                      # Enable extra console logs
SPECIAL_ACCESS_ROLE_IDS=ID_1,ID_2                   # Roles allowed to use restricted options ("raw", "/example")

# Slash command cooldown settings
COMMAND_PUBLIC_TOKEN_LIMIT=5                        # Public command tokens per user
COMMAND_PRIVATE_TOKEN_LIMIT=10                      # Hidden command tokens per user
COMMAND_TOKEN_RESET_SECONDS=600                     # Token reset window in seconds
COMMAND_TOKEN_RESET_ANCHOR=day                      # day or restart (count from 00:00 or from bot restart)
# Should users with certain roles be excluded from cooldowns (blacklist) or only allowed to use commands (whitelist)
COMMAND_COOLDOWN_ROLE_MODE=blacklist
COMMAND_COOLDOWN_ROLE_IDS=ID_1,ID_2                 # Role IDs used by cooldown role mode

# KF2 server 1
KF2_SERVER_1_ENABLED=true                           # Enable this server connection
KF2_SERVER_1_NAME=Normal                            # Display name
KF2_SERVER_1_DIFFICULTY=normal                      # Difficulty key used by slash commands
KF2_SERVER_1_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_1_PORT=2424                              # KF2 relay port
KF2_SERVER_1_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated
KF2_SERVER_1_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channels overrides, comma-separated
KF2_SERVER_1_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channels overrides, comma-separated
KF2_SERVER_1_WEBHOOK_URL=                           # Optional webhook for KF2 to Discord
KF2_SERVER_1_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_1_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_1_COMMANDS_ENABLED=true                  # Allow slash commands for this server

# KF2 server 2
KF2_SERVER_2_ENABLED=false                          # Enable this server connection
KF2_SERVER_2_NAME=Hard                              # Display name
KF2_SERVER_2_DIFFICULTY=hard                        # Difficulty key used by slash commands
KF2_SERVER_2_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_2_PORT=2425                              # KF2 relay port
KF2_SERVER_2_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated
KF2_SERVER_2_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channel overrides, comma-separated
KF2_SERVER_2_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channel overrides, comma-separated
KF2_SERVER_2_WEBHOOK_URL=                           # Optional webhook for KF2 to Discord
KF2_SERVER_2_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_2_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_2_COMMANDS_ENABLED=true                  # Allow slash commands for this server

# KF2 server 3
KF2_SERVER_3_ENABLED=false                          # Enable this server connection
KF2_SERVER_3_NAME=Suicidal                          # Display name
KF2_SERVER_3_DIFFICULTY=suicidal                    # Difficulty key used by slash commands
KF2_SERVER_3_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_3_PORT=2426                              # KF2 relay port
KF2_SERVER_3_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated
KF2_SERVER_3_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channel overrides, comma-separated
KF2_SERVER_3_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channel overrides, comma-separated
KF2_SERVER_3_WEBHOOK_URL=                           # Optional webhook for KF2 to Discord
KF2_SERVER_3_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_3_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_3_COMMANDS_ENABLED=true                  # Allow slash commands for this server

# KF2 server 4
KF2_SERVER_4_ENABLED=false                          # Enable this server connection
KF2_SERVER_4_NAME=HoE                               # Display name
KF2_SERVER_4_DIFFICULTY=hoe                         # Difficulty key used by slash commands
KF2_SERVER_4_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_4_PORT=2427                              # KF2 relay port
KF2_SERVER_4_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated
KF2_SERVER_4_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channel overrides, comma-separated
KF2_SERVER_4_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channel overrides, comma-separated
KF2_SERVER_4_WEBHOOK_URL=                           # Optional webhook for KF2 to Discord
KF2_SERVER_4_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_4_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_4_COMMANDS_ENABLED=true                  # Allow slash commands for this server

# KF2 server 5
KF2_SERVER_5_ENABLED=false                          # Enable this server connection
KF2_SERVER_5_NAME=Extreme                           # Display name
KF2_SERVER_5_DIFFICULTY=extreme                     # Difficulty key used by slash commands
KF2_SERVER_5_HOST=127.0.0.1                         # KF2 relay host
KF2_SERVER_5_PORT=2428                              # KF2 relay port
KF2_SERVER_5_DISCORD_CHANNEL_IDS=ID_1,ID_2          # Discord chat relay channels, comma-separated
KF2_SERVER_5_KICK_VOTE_DISCORD_CHANNEL_IDS=         # Optional kick-vote channel overrides, comma-separated
KF2_SERVER_5_PAUSE_SKIP_VOTE_DISCORD_CHANNEL_IDS=   # Optional pause/skip-vote channel overrides, comma-separated
KF2_SERVER_5_WEBHOOK_URL=                           # Optional webhook for KF2 to Discord
KF2_SERVER_5_FORWARD_KF2_TO_DISCORD=true            # Forward KF2 chat to Discord
KF2_SERVER_5_FORWARD_DISCORD_TO_KF2=true            # Forward Discord chat to KF2
KF2_SERVER_5_COMMANDS_ENABLED=true                  # Allow slash commands for this server
